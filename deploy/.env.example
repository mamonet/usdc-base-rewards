# repo: deploy/.env.example
# Copy to deploy/.env and fill in. .env is gitignored and must never be committed.
# Every value here is a placeholder. Do not paste a real key into this file, even
# temporarily: it is tracked, so anything written here ends up in git history forever.

# --- chain -------------------------------------------------------------------
# 84532 = Base Sepolia (default), 8453 = Base mainnet.
CHAIN_ID=84532
# Mainnet moves real money and needs a deliberate opt-in. Leave at 0.
ALLOW_MAINNET=0
# Public RPC works for a demo; use your own provider for anything sustained.
BASE_RPC_URL=https://sepolia.base.org
# Leave blank on Base Sepolia to use the built-in USDC address. Required on mainnet.
USDC_ADDRESS=
# Confirmations before a ledger entry is finalised as confirmed.
CONFIRMATIONS=1

# --- treasury ----------------------------------------------------------------
# A *reference*, never the key itself. Two accepted forms:
#   env:TREASURY_PRIVATE_KEY   - dev only, testnet only, throwaway funds only
#   awskms://alias/NAME        - resolved at call time, key never leaves the HSM
#
# IN ANYTHING REAL THIS MUST BE A KMS REFERENCE. A treasury key in an env var is one
# `docker inspect`, one crash dump or one log line away from being public, and a hot
# wallet that signs USDC transfers is a live target. Use KMS/HSM with a signing-only
# grant, rotate on a schedule, and keep the balance to what a pilot needs.
TREASURY_KEY_REF=0xTREASURY_KEY_REF
# Only read when TREASURY_KEY_REF is env:TREASURY_PRIVATE_KEY. Left commented out so the
# default configuration has nowhere to put a key at all. Testnet throwaway only.
# TREASURY_PRIVATE_KEY=REPLACE_ME

# --- webhook -----------------------------------------------------------------
# Shared secret from the merchant platform. HMAC-SHA256 over the raw request body.
WEBHOOK_SECRET=REPLACE_ME

# --- embedded wallet provider ------------------------------------------------
# privy | coinbase | local  (local is a testnet-only stub for offline runs)
WALLET_PROVIDER=local
PRIVY_APP_ID=REPLACE_ME
PRIVY_APP_SECRET=REPLACE_ME
COINBASE_API_KEY=REPLACE_ME

# --- reward rule -------------------------------------------------------------
# Seeded into reward_rules on first start if the table is empty; after that the row is
# the source of truth and these are ignored. Basis points: 250 = 2.50% of subtotal.
REWARD_RATE_BPS=250
# Per-order ceiling in USDC base units (6dp). 5000000 = 5.00 USDC. 0 = uncapped.
REWARD_MAX_BASE_UNITS=5000000
# Orders below this subtotal earn nothing, in base units.
REWARD_MIN_SUBTOTAL_BASE_UNITS=0

# --- cohort gate ---------------------------------------------------------------
# Percentage of customers in the treatment group. 0 disables issuance entirely.
COHORT_ROLLOUT_PERCENT=100
# Comma-separated emails. Allowlist always earns, denylist never does.
COHORT_ALLOWLIST=
COHORT_DENYLIST=
COHORT_CURRENCY=USD

# --- app ---------------------------------------------------------------------
# SQLite path for a bare `npm run dev`; compose overrides this with a Postgres URL.
DATABASE_URL=./data/rewards.db
PORT=3000

# --- compose only ------------------------------------------------------------
POSTGRES_PASSWORD=REPLACE_ME
